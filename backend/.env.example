PORT=3000

# MongoDB local via Docker (para executar a API fora do Docker):
MONGODB_URI=mongodb://localhost:27017/trabalho_final

# Para usar MongoDB Atlas, substitua a linha MONGODB_URI acima pela URI do seu cluster.
# Nunca coloque credenciais reais neste arquivo de exemplo ou no GitHub.

# Gere uma chave própria com pelo menos 32 caracteres e mantenha-a apenas no .env local.
JWT_SECRET=coloque_uma_chave_secreta_com_mais_de_32_caracteres
